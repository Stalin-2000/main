pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Jenkins is preparing the workspace'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Build stage started'
                sh 'ls -la'
            }
        }

        stage('Test') {
            steps {
                echo 'Test stage started'
                sh 'git --version'
            }
        }
    }
}
