
pipeline {
    agent any

    environment {
        APP_NAME = 'python-webapp'
        IMAGE_NAME = 'python-webapp'
        CONTAINER_NAME = 'python-webapp'
        APP_PORT = '8081'
        CONTAINER_PORT = '8000'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Python') {
            steps {
                sh '''
                    python3 --version
                    git --version
                    docker --version
                '''
            }
        }

        stage('Install Dependencies and Test') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/python -m pip install --upgrade pip
                    .venv/bin/python -m pip install -r requirements-dev.txt
                    .venv/bin/python -m pytest -v --junitxml=test-results.xml
                    .venv/bin/python -m pytest --cov=app --cov-report=xml:coverage.xml
                '''
            }
            post {
                always {
                    junit testResults: 'test-results.xml',
                          allowEmptyResults: true

                    archiveArtifacts artifacts: 'coverage.xml',
                                     allowEmptyArchive: true
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQubeServer') {
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=python-webapp \
                          -Dsonar.projectName="Python Web Application" \
                          -Dsonar.sources=app.py \
                          -Dsonar.tests=tests \
                          -Dsonar.python.coverage.reportPaths=coverage.xml
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                    docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Test Docker Container') {
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME}-test || true

                    docker run -d \
                      --name ${CONTAINER_NAME}-test \
                      -p 127.0.0.1:18080:8000 \
                      ${IMAGE_NAME}:${BUILD_NUMBER}

                    sleep 5

                    curl --fail http://127.0.0.1:18080/health

                    docker rm -f ${CONTAINER_NAME}-test
                '''
            }
            post {
                always {
                    sh 'docker rm -f python-webapp-test || true'
                }
            }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true

                    docker run -d \
                      --restart unless-stopped \
                      --name ${CONTAINER_NAME} \
                      -p ${APP_PORT}:${CONTAINER_PORT} \
                      ${IMAGE_NAME}:${BUILD_NUMBER}

                    sleep 5

                    curl --fail http://127.0.0.1:${APP_PORT}/health
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
            echo 'Python application deployed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
