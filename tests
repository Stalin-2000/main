from app import app


def test_home_page():
    with app.test_client() as client:
        response = client.get("/")

    assert response.status_code == 200
    assert b"Hello from Python!" in response.data


def test_health_endpoint():
    with app.test_client() as client:
        response = client.get("/health")

    assert response.status_code == 200
    assert response.get_json() == {"status": "healthy"}
